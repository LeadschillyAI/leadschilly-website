// Cloudflare settings: the site is served as static files from dist/ (built by `npm run build`).
// _redirects and _headers in public/ are applied by Cloudflare. Unknown addresses show the 404 page.
{
  "name": "leadschilly-website",
  "compatibility_date": "2026-09-01",
  // Preview address: leadschilly-website.hostmyworld.workers.dev (leadschilly.com gets added at launch)
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
