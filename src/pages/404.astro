---
import Base from '../layouts/Base.astro'
---
<Base title="Page not found | Leadschilly" noindex={true}>
  <section class="band">
    <div class="band-inner bg-sky">
      <div class="inner stack center gap-20">
        <h1 class="h1" style="font-size: clamp(36px, 4.4vw, 56px);">This page has moved or no longer exists.</h1>
        <p class="lead" style="max-width: 640px;">Leadschilly is now the AI sales team for real estate firms. These are good places to start:</p>
        <div class="btns" style="justify-content: center;">
          <a class="btn btn-lg btn-primary" href="/">Go to the homepage</a>
          <a class="btn btn-lg btn-white" href="/blog/">Read the blog</a>
          <a class="btn btn-lg btn-white" href="https://my.leadschilly.com">Log in</a>
        </div>
      </div>
    </div>
  </section>
</Base>
