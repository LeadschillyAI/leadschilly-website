---
import Base from '../layouts/Base.astro'
import PhoneChat from '../components/PhoneChat.astro'
import { LINKS, SITE, AI_ON_OUR_NUMBER as AI } from '../config'

const faqs = [
  { q: "Will my buyers know it's a bot?", a: 'It replies like a polite sales assistant, and hands the chat to your rep the moment a human is needed.' },
  { q: 'Does it replace my sales team?', a: 'No. It does the first reply and the qualifying, so your reps spend their day on site visits and closing.' },
  { q: 'Which lead sources work?', a: '99acres, MagicBricks, Housing.com, Facebook and Instagram lead ads, website forms and chat, WhatsApp, missed calls, and any tool that can send a lead (Make.com, n8n, your own systems).' },
  { q: 'What does it cost?', a: 'Plans start at ₹4,999 a month plus GST for the whole business, not per user. See the pricing page for all plans. India pays in ₹, everyone else in $.' },
]
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Leadschilly',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, Android',
  description: SITE.description,
  publisher: { '@id': `${SITE.url}/#organization` },
  offers: { '@type': 'Offer', price: '4999', priceCurrency: 'INR', url: `${SITE.url}/pricing/` },
}
const icon = {
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>',
  clock: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
}
---
<Base title="AI Sales Agent for Real Estate: More Site Visits from Every Lead | Leadschilly" description="Leadschilly's AI sales agent answers every property lead on WhatsApp in seconds, qualifies the buyer and books the site visit, so your reps only talk to buyers ready to visit." schema={[faqSchema, appSchema]}>

  <section class="band hero">
    <div class="band-inner bg-sky">
      <div class="inner hero-grid">
        <div class="hero-copy">
          <p class="pill-tag">Your AI sales agent for real estate</p>
          <h1 class="h1">More <span class="underline-orange rotate" data-phrases='["site visits","booked calendars","serious buyers","closings","site visits on weekdays","replies at 11 pm"]'>site visits</span> from the leads you already pay for.</h1>
          <p class="lead" style="font-size: 20px; max-width: 600px;">Leadschilly's AI sales agent replies to every property lead on WhatsApp in seconds, qualifies the buyer and books the site visit on your rep's calendar. Your team starts each morning with visits already booked.</p>
          <div class="btns" style="padding-top: 8px;">
            <a class="btn btn-lg btn-primary lift" href={LINKS.whatsappHi}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z"></path></svg>
              {AI ? 'Send "Hi" and watch it reply' : 'Chat with us on WhatsApp'}
            </a>
            <a class="btn btn-lg btn-white" href={LINKS.demo}>Book a 15-minute demo</a>
          </div>
          <p class="small">{AI ? 'Our AI will treat you like a buyer. Takes 2 minutes. No sign-up.' : 'Ask us anything about your leads. No sign-up.'}</p>
        </div>
        <PhoneChat />
      </div>
    </div>
  </section>

  <section aria-label="Leadschilly in numbers" class="wrap">
    <ul class="stats">
      <li><span class="bar bar-sm bar-magenta" aria-hidden="true"></span><span class="stat-num">1,300+</span><span class="stat-label">sign-ups</span></li>
      <li><span class="bar bar-sm bar-blue" aria-hidden="true"></span><span class="stat-num">Seconds</span><span class="stat-label">to the first reply on WhatsApp</span></li>
      <li><span class="bar bar-sm bar-orange" aria-hidden="true"></span><span class="stat-num">24×7</span><span class="stat-label">nights, Sundays and festivals</span></li>
      <li><span class="bar bar-sm bar-navy" aria-hidden="true"></span><span class="stat-num">3 clicks</span><span class="stat-label">to book a site visit from any chat</span></li>
    </ul>
  </section>

  <section class="section">
    <div class="wrap stack center gap-40">
      <div class="stack center gap-16" style="max-width: 780px;">
        <h2 class="h2">What your firm gets</h2>
        <p class="lead">Not a tool to manage leads. An agent that turns them into site visits while your team is busy, off, or asleep.</p>
      </div>
      <div class="row" style="width: 100%; text-align: left;">
        <div class="card card-raised">
          <span class="icon-tile"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icon.moon} /></svg></span>
          <h3 class="h3">A calendar full of site visits</h3>
          <p>Every enquiry is answered, qualified and offered a slot, nights and Sundays included. The buyer picks a time, and the visit lands on your rep's calendar with the full chat.</p>
        </div>
        <div class="card card-raised">
          <span class="icon-tile"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icon.phone} /></svg></span>
          <h3 class="h3">Reps who only talk to ready buyers</h3>
          <p>Budget, location and timeline are asked before a rep picks up the phone. Their day goes on closing, not chasing.</p>
        </div>
        <div class="card card-raised">
          <span class="icon-tile"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icon.clock} /></svg></span>
          <h3 class="h3">Ad money that stops leaking</h3>
          <p>Leads from 99acres, MagicBricks, Housing.com and your Meta ads get a reply in seconds, not at 10 am. Firms that reply within an hour are nearly 7 times more likely to qualify the lead.<sup>*</sup></p>
        </div>
      </div>
      <p class="punch">Same ad spend. More buyers at the site. More closings.</p>
      <p class="tiny">* Source: Harvard Business Review, "The Short Life of Online Sales Leads", 2011. Study of about 1.25 million sales leads.</p>
    </div>
  </section>

  <section id="how" class="band">
    <div class="band-inner bg-panel">
      <div class="inner hero-grid" style="gap: 64px;">
        <div class="stack gap-40" style="flex: 999 1 480px; min-width: 0; gap: 36px;">
          <h2 class="h2">From enquiry to site visit, without anyone lifting a phone.</h2>
          <ol class="steps">
            <li><span class="step-num">1</span><div class="stack" style="gap: 6px;"><h3 class="h3">A lead comes in</h3><p class="body">From 99acres, MagicBricks and Housing.com, your Facebook and Instagram ads, your website or WhatsApp.</p></div></li>
            <li><span class="step-num">2</span><div class="stack" style="gap: 6px;"><h3 class="h3">Leadschilly replies on WhatsApp in seconds</h3><p class="body">It asks what a good rep would ask: budget, location, size, and when they want to move.</p></div></li>
            <li><span class="step-num">3</span><div class="stack" style="gap: 6px;"><h3 class="h3">It books the site visit and hands over</h3><p class="body">The buyer picks a slot. Reminders go out on their own, and your rep gets the visit, the buyer's answers and the full chat.</p></div></li>
          </ol>
          <div class="stack gap-12">
            <p class="punch">Your reps stop chasing. They start closing.</p>
            <p class="small" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px;"><span class="tag tag-soon">Coming soon</span>AI voice calls for leads who don't reply on WhatsApp</p>
          </div>
        </div>
        <figure class="shot" style="flex: 1 1 340px;">
          <div class="shot-frame" style="max-width: 380px;">
            <img src="/images/app-phone-chat.webp" width="780" height="1113" loading="lazy" alt="Inside Leadschilly: the AI confirms a site visit on WhatsApp and starts reminders for the rep">
          </div>
          <figcaption style="max-width: 380px;">Inside Leadschilly: the AI confirms the visit and sets reminders. Sample data.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack gap-40">
      <h2 class="h2 measure">Same leads. More site visits.</h2>
      <div class="row cols-4">
        <div class="card card-grey"><span class="bar bar-magenta" aria-hidden="true"></span><h3>Every lead answered</h3><p>Nights, Sundays and festival weekends included.</p></div>
        <div class="card card-grey"><span class="bar bar-blue" aria-hidden="true"></span><h3>Only serious buyers reach your reps</h3><p>Budget and timeline are asked before anyone picks up the phone.</p></div>
        <div class="card card-grey"><span class="bar bar-orange" aria-hidden="true"></span><h3>More visits from the same ad spend</h3><p>You stop paying for leads that die in the inbox.</p></div>
        <div class="card card-grey"><span class="bar bar-navy" aria-hidden="true"></span><h3>You see everything</h3><p>Every chat and every booked visit in one place, so you know which rep and which source is working.</p></div>
      </div>
    </div>
  </section>

  <section id="discipline" class="band">
    <div class="band-inner bg-sky">
      <div class="inner stack gap-48">
        <div class="stack center gap-16">
          <p class="eyebrow">For owners and sales heads</p>
          <h2 class="h2" style="max-width: 820px;">Discipline you don't have to enforce.</h2>
          <p class="lead" style="max-width: 720px;">Every lead, call and follow-up runs through one place, and AI tells each person what matters today. Nothing depends on someone remembering.</p>
        </div>
        <figure class="shot">
          <div class="shot-frame" style="max-width: 1040px; padding: 16px;">
            <img src="/images/app-dashboard.webp" width="1600" height="591" loading="lazy" alt="Leadschilly owner dashboard showing leads, site visits, bookings, ad spend, first reply time and leads per day">
          </div>
          <figcaption>The owner's dashboard in Leadschilly. Sample data.</figcaption>
        </figure>
        <div class="row cols-2">
          <div class="card card-white"><span class="bar bar-magenta" aria-hidden="true"></span><h3>Every morning, a plan for everyone</h3><p>Each rep opens My Day: a ranked call list, follow-ups due and their targets. Managers get a Team Board, owners a Business Cockpit. Reply speed and overdue follow-ups show week on week, so you see who's slipping without chasing anyone.</p></div>
          <div class="card card-white"><span class="bar bar-blue" aria-hidden="true"></span><h3>Every call counted</h3><p>Call any lead in one click through your calling provider. Calls are recorded and outcomes logged, and a missed call becomes a lead with a call-back task. Follow-ups happen because they're scheduled, not remembered.</p></div>
          <div class="card card-white"><span class="bar bar-orange" aria-hidden="true"></span><h3>One inbox for every conversation</h3><p>WhatsApp, website chat, calls and SMS sit together on every lead. When a rep leaves, the buyer history stays with your firm, not on their phone.</p></div>
          <div class="card card-white"><span class="bar bar-navy" aria-hidden="true"></span><h3>Leads arrive on their own</h3><p>99acres, MagicBricks, Housing.com, Facebook and Instagram lead ads, your website forms and chat, and tools like Make.com connect once. Leads land in seconds and go straight to the right rep.</p></div>
        </div>
        <p class="punch" style="text-align: center;">Follow-ups that happen on time turn into site visits. Site visits turn into closings.</p>
      </div>
    </div>
  </section>

  <section id="who" class="section">
    <div class="wrap stack gap-40">
      <h2 class="h2 measure">Built for the people who live on property leads.</h2>
      <div class="row">
        <div class="card card-grey" style="padding: 32px;"><span class="bar bar-magenta" aria-hidden="true"></span><h3>Brokers and consultants</h3><p>Answer 200 WhatsApp enquiries a week and still be out doing site visits.</p></div>
        <div class="card card-grey" style="padding: 32px;"><span class="bar bar-blue" aria-hidden="true"></span><h3>Channel partners</h3><p>Know which project, budget and location each lead fits before a rep ever calls.</p></div>
        <div class="card card-grey" style="padding: 32px;"><span class="bar bar-orange" aria-hidden="true"></span><h3>Developer sales teams</h3><p>Evening enquiries become morning site visits, even after the call centre goes home.</p></div>
      </div>
      <p class="body">Works anywhere your buyers use WhatsApp.</p>
    </div>
  </section>

  <section style="padding: 0 0 96px;">
    <div class="wrap stack gap-24">
      <div class="callout">
        <div>
          <h2 class="h2" style="font-size: clamp(28px, 3vw, 40px);">{AI ? 'Try it the way your buyer would.' : 'See it on your own leads.'}</h2>
          <p class="body" style="font-size: 17px;">{AI ? `The fastest proof is the product itself. Send "Hi" to ${SITE.whatsappDisplay} and judge the reply as a buyer would.` : `The fastest proof is your own leads. Message us on WhatsApp at ${SITE.whatsappDisplay} and we'll show you the AI answering them.`}</p>
        </div>
        <a class="btn btn-lg btn-primary" href={LINKS.whatsappHi}>{AI ? 'Try it on WhatsApp' : 'Chat on WhatsApp'}</a>
      </div>
      <div class="stack gap-20" style="padding-top: 32px;">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px;">
          <h3 style="font-size: 26px; font-weight: 800;">What it looks like in practice</h3>
          <span class="tag tag-neutral">Example scenarios, not customer reviews</span>
        </div>
        <div class="row">
          <div class="card card-grey"><span class="bar bar-magenta" aria-hidden="true"></span><h4 style="font-size: 18px;">A small broker team, Sunday night</h4><p>Three enquiries arrive from an ad while the team is off. Each gets a WhatsApp reply in seconds and is asked budget and timeline. By Monday morning, the serious ones are already booked for site visits.</p></div>
          <div class="card card-grey"><span class="bar bar-blue" aria-hidden="true"></span><h4 style="font-size: 18px;">A channel partner with many projects</h4><p>Ads run for several projects at once. Every lead is asked which project, budget and location, so reps only call buyers who actually fit.</p></div>
          <div class="card card-grey"><span class="bar bar-orange" aria-hidden="true"></span><h4 style="font-size: 18px;">A developer's sales team after 7 pm</h4><p>The call centre has gone home. Evening enquiries are still answered and qualified, and the team starts the day with booked visits and the full chats.</p></div>
        </div>
      </div>
      <p style="display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 15px; font-weight: 600; color: var(--navy); padding-top: 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        Your data stays yours
      </p>
    </div>
  </section>

  <section class="band">
    <div class="band-inner bg-panel">
      <div class="inner stack gap-40">
        <h2 class="h2" style="text-align: center;">Questions brokers ask us</h2>
        <div class="row cols-2" style="gap: 16px;">
          {faqs.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              {f.q === 'What does it cost?'
                ? <p class="body" style="font-size: 15px;">Plans start at ₹4,999 a month plus GST for the whole business, not per user. See the <a href="/pricing/">pricing page</a>. India pays in ₹, everyone else in $.</p>
                : <p class="body" style="font-size: 15px;">{f.a}</p>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="demo" style="padding: 96px 16px;">
    <div class="cta-block">
      <div class="inner">
        <span class="dots" aria-hidden="true"><span style="background: var(--magenta);"></span><span style="background: var(--blue);"></span><span style="background: var(--orange);"></span></span>
        <h2>Your next lead gets answered in seconds. Even at 11 pm.</h2>
        <p style="font-size: 18px; max-width: 640px;">Try Leadschilly free for 30 days on your own leads. We set it up with you, and you keep it only if it books you more site visits.</p>
        <div class="btns" style="justify-content: center;">
          <a class="btn btn-lg btn-white" href={LINKS.pilot}>Get a free 30-day pilot</a>
          <a class="btn btn-lg btn-ghost-light" href={LINKS.whatsappHi}>Book a 15-minute demo on WhatsApp</a>
        </div>
        <a class="soft-link" href={LINKS.whatsappHi} style="font-size: 16px; font-weight: 600;">{AI ? 'Or send "Hi" and watch it reply' : 'Or just say "Hi" on WhatsApp'}</a>
      </div>
    </div>
  </section>

<script is:inline>
  // One fixed headline for Google; only the orange phrase changes, every 3 seconds. Off when the visitor prefers less motion.
  (function () {
    var el = document.querySelector('.rotate'); if (!el) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    var list = JSON.parse(el.getAttribute('data-phrases')), i = 0
    setInterval(function () {
      el.classList.add('out')
      setTimeout(function () { i = (i + 1) % list.length; el.textContent = list[i]; el.classList.remove('out') }, 350)
    }, 3000)
  })()
</script>
</Base>
