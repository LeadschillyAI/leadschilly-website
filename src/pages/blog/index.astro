---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
---
<Base title="Blog: Real Estate Lead Response and Sales Playbooks | Leadschilly" description="Practical guides for brokers, channel partners and developer sales teams: replying to property leads fast, booking more site visits and running a disciplined sales team." current="/blog/">
  <section class="band">
    <div class="band-inner bg-sky" style="padding: 72px 24px;">
      <div class="inner stack gap-16" style="max-width: 820px;">
        <p class="eyebrow">Leadschilly blog</p>
        <h1 class="h1" style="font-size: clamp(36px, 4.4vw, 56px);">Playbooks for real estate sales teams</h1>
        <p class="lead">How to reply to property leads faster, qualify buyers and book more site visits.</p>
      </div>
    </div>
  </section>
  <section class="section" style="padding-top: 64px;">
    <div class="wrap">
      {posts.length === 0
        ? <p class="lead">The first posts are on their way.</p>
        : <div class="row cols-2">
            {posts.map((p) => (
              <a class="post-card" href={`/blog/${p.id}/`}>
                <span class="post-meta">{fmt(p.data.pubDate)}</span>
                <h2>{p.data.title}</h2>
                <p class="body" style="font-size: 15px;">{p.data.description}</p>
              </a>
            ))}
          </div>}
    </div>
  </section>
</Base>
